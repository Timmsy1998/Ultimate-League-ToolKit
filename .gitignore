dist/
dist-electron/
out/
release/

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Electron packaging
*.exe
*.dmg
*.AppImage

# Misc
*.tsbuildinfo
.eslintcache
